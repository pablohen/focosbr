{
	"name": "focosbr",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"geo:municipalities": "node scripts/municipalities.ts",
		"geo:centroids": "tsx scripts/centroids.ts",
		"history:build": "tsx --env-file-if-exists=.env scripts/history.ts"
	},
	"dependencies": {
		"@fontsource/inter": "5.3.0",
		"@mantine/core": "^9.7.3",
		"@mantine/hooks": "^9.7.3",
		"@mantine/nprogress": "^9.7.3",
		"@mantine/spotlight": "9.7.3",
		"@phosphor-icons/react": "^2.1.10",
		"@resvg/resvg-wasm": "2.6.2",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-start": "^1.169.3",
		"maplibre-gl": "^6.15.0",
		"mongodb": "^7.7.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"satori": "0.63.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-query-devtools": "^5.104.5",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"fflate": "0.8.3",
		"geotiff": "^3.0.5",
		"nitro": "3.0.260903-beta",
		"postcss": "^8.5.31",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "8.3.5",
		"vitest": "^5.0.5"
	}
}
